rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // Helper Functions
    // ==========================================

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Get the authenticated user's tenant ID from custom claims
    function getTenantId() {
      return request.auth.token.tenantId;
    }

    // Get the authenticated user's role from custom claims
    function getUserRole() {
      return request.auth.token.role;
    }

    // Check if user belongs to a specific tenant
    function belongsToTenant(tenantId) {
      return isAuthenticated() && getTenantId() == tenantId;
    }

    // Check if user has a specific role
    function hasRole(role) {
      return isAuthenticated() && getUserRole() == role;
    }

    // Check if user has one of the specified roles
    function hasAnyRole(roles) {
      return isAuthenticated() && getUserRole() in roles;
    }

    // Check if user is a platform admin
    function isPlatformAdmin() {
      return isAuthenticated() && request.auth.token.platformAdmin == true;
    }

    // Check if user has write permissions (owner, admin, or staff)
    function hasWriteRole() {
      return hasAnyRole(['owner', 'admin', 'staff']);
    }

    // Check if user has management permissions (owner or admin)
    function hasManagementRole() {
      return hasAnyRole(['owner', 'admin']);
    }

    // Check if user is the owner
    function isOwner() {
      return hasRole('owner');
    }

    // Check if user is a partner with access to specific data
    function isPartnerWithAccess(partnerOfficeId) {
      return hasRole('partner') && request.auth.token.partnerOfficeId == partnerOfficeId;
    }

    // ==========================================
    // Platform-Level Collections (Root)
    // ==========================================

    // Subscriptions - accessible by platform admins and tenant owners
    match /subscriptions/{tenantId} {
      allow read: if isPlatformAdmin() || (belongsToTenant(tenantId) && isOwner());
      allow write: if isPlatformAdmin();
    }

    // Platform settings - only platform admins
    match /platformSettings/{document=**} {
      allow read, write: if isPlatformAdmin();
    }

    // Email collection for Firebase Extension - allow authenticated users to create
    match /mail/{mailId} {
      allow create: if isAuthenticated();
      allow read: if false; // Only backend/extension reads
    }

    // ==========================================
    // Tenant-Level Collections
    // ==========================================

    match /tenants/{tenantId} {
      // Tenant document - read by members, write by management
      allow read: if belongsToTenant(tenantId);
      allow write: if belongsToTenant(tenantId) && hasManagementRole();

      // ==========================================
      // Users Collection
      // ==========================================
      match /users/{userId} {
        // Users can read their own profile, management can read all
        allow read: if belongsToTenant(tenantId) &&
          (request.auth.uid == userId || hasManagementRole());

        // Users can update their own profile (limited fields)
        // Management can create/update/delete users
        allow create: if belongsToTenant(tenantId) && hasManagementRole();
        allow update: if belongsToTenant(tenantId) &&
          (request.auth.uid == userId || hasManagementRole());
        allow delete: if belongsToTenant(tenantId) && hasManagementRole();
      }

      // ==========================================
      // Packages Collection
      // ==========================================
      match /packages/{packageId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if belongsToTenant(tenantId) && hasWriteRole();

        // Services subcollection
        match /services/{serviceId} {
          allow read: if belongsToTenant(tenantId);
          allow write: if belongsToTenant(tenantId) && hasWriteRole();
        }
      }

      // ==========================================
      // Customers Collection
      // ==========================================
      match /customers/{customerId} {
        // Staff can read all customers
        // Customers can read their own record (if linked via userId)
        allow read: if belongsToTenant(tenantId) ||
          (isAuthenticated() && resource.data.userId == request.auth.uid);
        allow write: if belongsToTenant(tenantId) && hasWriteRole();
      }

      // ==========================================
      // Bookings Collection
      // ==========================================
      match /bookings/{bookingId} {
        // Staff can read all bookings
        // Partners can read bookings that include their services
        allow read: if belongsToTenant(tenantId) ||
          (isAuthenticated() && hasRole('partner') &&
           request.auth.token.partnerOfficeId in resource.data.partnerOfficeIds);
        allow write: if belongsToTenant(tenantId) && hasWriteRole();
      }

      // ==========================================
      // Invoices Collection
      // ==========================================
      match /invoices/{invoiceId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if belongsToTenant(tenantId) && hasWriteRole();
      }

      // ==========================================
      // Payments Collection
      // ==========================================
      match /payments/{paymentId} {
        allow read: if belongsToTenant(tenantId);
        // Only management can approve/modify payments
        allow create: if belongsToTenant(tenantId) && hasWriteRole();
        allow update: if belongsToTenant(tenantId) && hasManagementRole();
        allow delete: if belongsToTenant(tenantId) && hasManagementRole();
      }

      // ==========================================
      // Partner Offices Collection
      // ==========================================
      match /partnerOffices/{partnerId} {
        // Staff can read all partners
        // Partners can read their own office
        allow read: if belongsToTenant(tenantId) ||
          (isAuthenticated() && isPartnerWithAccess(partnerId));
        allow write: if belongsToTenant(tenantId) && hasManagementRole();
      }

      // ==========================================
      // Commission Settlements Collection
      // ==========================================
      match /commissionSettlements/{settlementId} {
        // Staff and relevant partners can read
        allow read: if belongsToTenant(tenantId) ||
          (isAuthenticated() && hasRole('partner') &&
           resource.data.partnerOfficeId == request.auth.token.partnerOfficeId);
        allow write: if belongsToTenant(tenantId) && hasManagementRole();
      }

      // ==========================================
      // Notifications Collection
      // ==========================================
      match /notifications/{notificationId} {
        // Users can only read their own notifications
        allow read: if belongsToTenant(tenantId) &&
          resource.data.userId == request.auth.uid;
        // System creates notifications, users can mark as read
        allow create: if belongsToTenant(tenantId) && hasWriteRole();
        allow update: if belongsToTenant(tenantId) &&
          resource.data.userId == request.auth.uid;
        allow delete: if false; // Notifications cannot be deleted
      }

      // ==========================================
      // Audit Logs Collection
      // ==========================================
      match /auditLogs/{logId} {
        // Only management can read audit logs
        allow read: if belongsToTenant(tenantId) && hasManagementRole();
        // Audit logs are created by the system, never modified
        allow create: if belongsToTenant(tenantId) && hasWriteRole();
        allow update, delete: if false;
      }

      // ==========================================
      // Counters Collection (for sequential numbers)
      // ==========================================
      match /counters/{counterId} {
        allow read, write: if belongsToTenant(tenantId) && hasWriteRole();
      }
    }
  }
}
